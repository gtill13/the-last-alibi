engine_name="Godot Engine"

[application]
name="The Last Alibi"
run/main_scene="res://scenes/app/main.tscn"

[autoload]
GameState="res://scripts/autoload/game_state.gd"
SceneRouter="res://scripts/autoload/scene_router.gd"

[rendering]
renderer="forward+"

[display]
window/size/width=1280
window/size/height=720
window/test_width=1280
window/test_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/use_vsync=true

[input_map]
move_left = {
    "deadzone": 0.5,
    "events": [{"type": 1, "id": 97}]
}
move_right = {
    "deadzone": 0.5,
    "events": [{"type": 1, "id": 100}]
}
interact = {
    "deadzone": 0.5,
    "events": [{"type": 1, "id": 31}]
}
open_notebook = {
    "deadzone": 0.5,
    "events": [{"type": 1, "id": 110}]
}
cancel = {
    "deadzone": 0.5,
    "events": [{"type": 1, "id": 49}]
}
confirm = {
    "deadzone": 0.5,
    "events": [{"type": 1, "id": 32}]
}
toggle_fullscreen = {
    "deadzone": 0.5,
    "events": [{"type": 1, "id": 297}]
}

[resource]
script = ExtResource(1)
case_id = &"bellweather_apartment"
title = "The Bellweather Apartment"
briefing = "Um corpo foi encontrado no apartamento Bellweather. A polícia isolou o local e removeu o corpo, mas ainda não fez uma investigação profunda. Caberá a você reexaminar a cena."
